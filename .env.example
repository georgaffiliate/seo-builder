# copy to .env and fill in
# token that client containers must send as "Authorization: Bearer <token>"
API_TOKEN=change-me

# LLM content pack (used by --with-llm builds); leave empty to fall back to
# the language text bank (site still builds)
VENICE_API_KEY=

# hosting panel: store lookup + zip upload
PANEL_API_KEY=
PANEL_API_URL=https://florentina-tr.shop
